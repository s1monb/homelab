# Tracked, and deliberately free of secrets. Those live in layer0/tofu/.envrc,
# which is gitignored -- see layer0/tofu/.envrc.example.
#
# Both files below are produced by `tofu apply` in layer0/tofu/cluster.
export TALOS_TOFU_DIR="$(pwd)/layer0/tofu/cluster"
export TALOSCONFIG="$TALOS_TOFU_DIR/output/talosconfig"
export KUBECONFIG="$TALOS_TOFU_DIR/output/kubeconfig"
